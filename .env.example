# ---------------------------------------------------------------------------
# EasyOA — environment configuration example
#
# 使用方式：
#   cp .env.example .env
#   然后修改所有 CHANGE_ME 值。
#
# 说明：
#   - .env 不会被提交到 Git（见 .gitignore）。
#   - 生产部署必须替换所有默认值与密钥。
# ---------------------------------------------------------------------------

# --- 部署标识 --------------------------------------------------------------
# 对外访问地址（用于生成链接、CORS 校验与文档）
EASYOA_BASE_URL=https://localhost
# 运行模式：dev / prod（对应 Spring Profile）
EASYOA_PROFILE=prod

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=easyoa
POSTGRES_USER=easyoa
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
# 仅当使用 docker-compose.dev.yml 时，数据库会映射到宿主机以下地址
POSTGRES_DEV_PORT=5432
# 本机开发 API / Web 端口（start --dev 使用；生产 API 容器仍为 8080）
EASYOA_API_PORT=8080
EASYOA_DEV_WEB_PORT=5173

# --- 应用安全 --------------------------------------------------------------
# 会话/敏感数据加密主密钥：HMAC 签名会话标识、未来加密 TOTP Secret 等
# 要求：长度 >= 32，随机生成，例如：
#   openssl rand -base64 48
EASYOA_SESSION_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_RANDOM_SECRET

# 会话有效期（分钟）
EASYOA_SESSION_TIMEOUT_MINUTES=480

# 登录失败限制：连续失败次数与锁定时长（分钟）
EASYOA_LOGIN_MAX_FAILURES=5
EASYOA_LOGIN_LOCK_MINUTES=15

# --- 文件存储 --------------------------------------------------------------
# 附件存储目录（容器内路径，生产环境请挂载持久化卷）
EASYOA_STORAGE_PATH=/var/lib/easyoa/storage
# 单个附件大小上限（字节），默认 20MB
EASYOA_STORAGE_MAX_FILE_SIZE=20971520

# --- 首次初始化 ------------------------------------------------------------
# 组织名称（首次初始化页面默认值）
EASYOA_ORG_NAME=Easy Studio

# 开发环境演示数据开关（仅 dev profile 生效；设为 false 可验证 /setup 首次初始化流程）
# 生产环境（prod profile）永远不会创建演示数据，该变量不生效
EASYOA_DEV_SEED=false

# --- HTTP / TLS ------------------------------------------------------------
# 边缘 Nginx 对外端口
EASYOA_HTTP_PORT=80
EASYOA_HTTPS_PORT=443
# 证书目录（宿主机路径，默认 infra/nginx/certs）
EASYOA_TLS_CERT_DIR=./infra/nginx/certs

# 修改版部署应提供对应源码地址（关于页显示；留空时使用构建对应的官方源码链接）
EASYOA_SOURCE_URL=

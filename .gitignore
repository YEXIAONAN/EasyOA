# ---------------------------------------------------------------------------
# EasyOA — ignore rules
# ---------------------------------------------------------------------------

# Secrets & environment
.env
.env.local
.env.*.local
*.pem
*.key
*.crt
!infra/nginx/certs/.gitkeep

# Release integrity: public key is committable; manifest/signature are release artifacts
!integrity/release-public-key.pem
integrity/manifest.sha256
integrity/manifest.sig

# Backend — Java / Maven
backend/target/
*.class
*.jar
*.war
!**/src/**/*.jar
# Maven Wrapper jar 需要提交，保证任何人 clone 后可直接 ./mvnw 构建
!backend/.mvn/wrapper/maven-wrapper.jar
hs_err_pid*
replay_pid*

# Frontend — Node / Vite
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/coverage/
frontend/.vite/

# 本地开发附件存储（生产使用独立卷 / 目录）
storage/
frontend/*.tsbuildinfo
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs & runtime
logs/
*.log
backend/logs/

# Docker volumes (if bind-mounted locally)
infra/data/

# Build/release artifacts
/release/
*.tar.gz
*.zip

# ---------------------------------------------------------------------------
# Local AI Agent Skills
# ---------------------------------------------------------------------------
# EasyOAAgent.md / AGENTS.md are repository policies and MUST be committed.
# Local skills are workstation-specific and must never be pushed to GitHub.

.agents/skills/
.claude/skills/

# Local AI scratch / temporary context
.ai-local/
.agent-cache/


# Deployment backups and downloaded releases
backups/
.download-cache/
*.private.pem
release-signing-key*

# Python tooling caches
__pycache__/
*.pyc

<?xml version="1.0" encoding="UTF-8"?>
<!--
  EasyOA 日志配置（结构化 key=value 输出，适配容器 stdout 采集）。
  禁止输出：密码、TOTP、Session、完整敏感表单内容。
-->
<configuration>
  <property name="LOG_PATTERN"
            value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] [requestId=%X{requestId:-}] %logger{36} - %msg%n"/>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>${LOG_PATTERN}</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <!-- 访问日志单独 Logger，避免与业务日志混杂 -->
  <logger name="EASYOA_ACCESS" level="INFO" additivity="false">
    <appender-ref ref="CONSOLE"/>
  </logger>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>

  <springProfile name="dev">
    <logger name="com.easyoa" level="DEBUG"/>
  </springProfile>

  <springProfile name="prod">
    <logger name="com.easyoa" level="INFO"/>
    <logger name="org.hibernate.SQL" level="WARN"/>
  </springProfile>
</configuration>
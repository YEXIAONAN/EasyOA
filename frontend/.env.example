# ---------------------------------------------------------------------------
# EasyOA 前端构建期环境变量示例
# 仅构建时注入（VITE_ 前缀），不要把任何密钥放在前端配置中。
# ---------------------------------------------------------------------------

# API 基础路径。默认 /api：
#   - 开发模式：由 Vite dev server 代理到本机后端（vite.config.ts）
#   - 生产模式：由 Nginx 反向代理到 easyoa-api
VITE_API_BASE=/api

# 产品名称（用于页面标题等）
VITE_APP_NAME=EasyOA